# flyfunboarding secrets: copy to .env.secrets (gitignored, keep it mode 600) and fill in.
# Plain configuration is in .env (see .env.sample / .env.docker.example).
# The app (pydantic settings) reads .env then .env.secrets. Docker compose interpolates
# every value, so once this file exists deploy with:
#   docker compose --env-file .env --env-file .env.secrets -f docker-compose.prod.yml up -d
# In the owner's setup this file is sops-encrypted in the config repo and decrypted by
# syncfiles on the host that uses it: don't hand-edit it there.

# Database password (must match the user in shared-infra MySQL)
DB_PASSWORD=your_db_password

# Signing secret (unused while USE_PUBLIC_KEY_SIGNATURE=true)
SECRET=your-secret-key-here

# PKPass certificate password (empty when the certificate has none)
CERTIFICATE_PASSWORD=
