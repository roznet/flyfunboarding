# Plain configuration. Secrets (DB_PASSWORD, SECRET, CERTIFICATE_PASSWORD) go in
# .env.secrets next to it: see .env.secrets.sample. The app reads both files; docker
# compose needs --env-file .env --env-file .env.secrets once the secrets file exists.

# ============================================
# Fly Fun Boarding API Configuration
# ============================================
# Copy this file to .env and update with your actual values
# Never commit .env to version control

# ============================================
# Database Configuration
# ============================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
# DB_PASSWORD: in .env.secrets
DB_NAME=flyfunboarding

# ============================================
# Apple Wallet PKPass Configuration
# ============================================
# Paths can be absolute or relative to BASE_DIR (server/ directory)
CERTIFICATE_PATH=../certs/certificate.pem
# CERTIFICATE_PASSWORD: in .env.secrets
WWDR_PATH=../certs/AppleWWDRCA.pem

# ============================================
# File Paths
# ============================================
# Paths relative to BASE_DIR (server/ directory)
KEYS_PATH=../keys
IMAGES_PATH=../images
AIRPORT_DB_PATH=../data/airports.db  # Used by euro_aip library (DO NOT read directly)

# ============================================
# Security
# ============================================
# Secret key for system-level authentication
# SECRET: in .env.secrets
USE_PUBLIC_KEY_SIGNATURE=true

# ============================================
# API Configuration
# ============================================
API_VERSION=v1
DEBUG=false

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins, or "*" for all
CORS_ORIGINS=*

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=INFO
# Leave empty for stdout, or specify file path
LOG_FILE=
