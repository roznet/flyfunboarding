# Docker environment variables for flyfunboarding-api
# Copy to .env and update with your values; secrets go in .env.secrets.
# Compose reads this file for the ${...} values in docker-compose.yml; it is NOT passed to
# the container whole. Deploy: docker compose up -d --build

# Database credentials (must match what's configured in shared-infra MySQL)
DB_USER=flyfunboarding
# DB_PASSWORD: in .env.secrets (see .env.secrets.sample)
DB_NAME=flyfunboarding

# Security
# SECRET: in .env.secrets (see .env.secrets.sample)
USE_PUBLIC_KEY_SIGNATURE=true

# PKPass certificate password (if any)
# CERTIFICATE_PASSWORD: in .env.secrets (see .env.secrets.sample)

# API Config
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=*
